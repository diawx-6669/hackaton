# ============================================================
# CampusLens AI — пример окружения. Скопируй в .env и заполни.
# Реальный .env в git НЕ коммитится (см. .gitignore).
# ============================================================

# --- Backend (FastAPI) ---
# Wikimedia требует осмысленный User-Agent с контактом, иначе режет запросы.
CAMPUSLENS_USER_AGENT="CampusLens-AI/0.1 (hackathon LOCUS 2026; mailto:you@example.com)"

# Общий бюджет времени на сборку профиля, секунды (шаг 3 ТЗ).
CAMPUSLENS_TOTAL_TIMEOUT=25.0
# Таймаут одного HTTP-запроса к внешнему API, секунды.
CAMPUSLENS_HTTP_TIMEOUT=10.0

# Сколько файлов максимум тянуть из одного сборщика.
CAMPUSLENS_MAX_FILES_PER_SOURCE=120
# Радиус geosearch по Commons вокруг координат кампуса, метры.
CAMPUSLENS_GEOSEARCH_RADIUS=1000
# Глубина обхода подкатегорий Commons.
CAMPUSLENS_CATEGORY_DEPTH=2

# Кеш: ускоряет повторные запросы и бережёт лимиты Wikimedia.
CAMPUSLENS_CACHE_ENABLED=true
CAMPUSLENS_CACHE_DIR="data/cache"
CAMPUSLENS_CACHE_TTL_RESOLVE=86400
CAMPUSLENS_CACHE_TTL_PHOTOS=21600

# CORS: откуда фронту можно ходить в API (через запятую).
# На проде сюда добавить адрес фронта, например https://campuslens.vercel.app
CAMPUSLENS_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Опциональные источники (шаг 8 ТЗ, пока не обязательны) ---
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
# LLM-описание кампуса (шаг 6 ТЗ). Без ключа описание просто не генерируется,
# профиль при этом собирается как обычно.
# Провайдер выбирается автоматически по заданному ключу (порядок: gemini,
# groq, anthropic). Можно задать явно:
# CAMPUSLENS_LLM_PROVIDER=gemini | groq | anthropic
#
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
CAMPUSLENS_GEMINI_MODEL="gemini-3.6-flash"
#
# Groq: https://console.groq.com/keys
# Список актуальных моделей: https://console.groq.com/docs/models
GROQ_API_KEY=
CAMPUSLENS_GROQ_MODEL="llama-3.3-70b-versatile"
#
# Anthropic: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
CAMPUSLENS_LLM_MODEL="claude-opus-5"

# --- Frontend (Next.js) ---
# ВНИМАНИЕ: этот файл описывает переменные БЭКЕНДА. При импорте на Vercel
# он подхватывается целиком — оставляйте там только NEXT_PUBLIC_API_BASE_URL,
# остальные 14 переменных фронтенду не нужны (см. DEPLOY.md, шаг 2).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
